# LiveKit Cloud project used by Buddy's browser and video Worker.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Buddy owns this registration. It must match apps/video-worker/wrangler.toml.
AGENT_NAME=buddys-avatar
AGENT_HTTP_PORT=8092

# Buddy-only LemonSlice relay. The provider key stays in buddys-video-worker.
BUDDYS_VIDEO_RELAY_URL=https://buddys-video-worker.cryptocapitalgroupfl.workers.dev/internal/lemonslice/sessions

# Buddy's voice runtime. Never point this at EILA-Overwatch or port 8200.
BLACKHOLE_BUDDYS_RUNTIME_URL=https://buddy-voice.xyz-labs.xyz
BLACKHOLE_BUDDYS_RUNTIME_TOKEN=
BUDDY_LIVEKIT_STREAMING_TTS=true
BUDDY_GREETING_SETTLE_MS=250

# Local Ollama used by Buddy's avatar agent.
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen3.5:9b
LOCAL_LLM_TEMPERATURE=0.35
LOCAL_LLM_REASONING_EFFORT=none
LIVEKIT_STT_MODEL=deepgram/nova-3


.crm-banner{position:relative;min-height:154px;padding:18px 28px 18px 185px;overflow:hidden;border-bottom:4px solid #ffe522;background:radial-gradient(ellipse at 75% 15%,#346bc8,transparent 65%),linear-gradient(115deg,#0a214b,#163d85);color:#fff}
.crm-buddy{position:absolute;left:20px;bottom:0;width:155px;height:174px;background:url('/buddys/images/buddy-show.PNG') 30% 8px/auto 180px no-repeat;border-radius:18px 18px 0 0;mask-image:linear-gradient(to right,transparent,#000 12%,#000 90%,transparent)}
.buddy-app .kpi{max-width:200px;width:100%}
.crm-brand-copy{display:flex;align-items:center;gap:25px;min-width:0}.crm-brand-copy img{width:300px;max-width:42%;height:96px;object-fit:contain;object-position:left;filter:drop-shadow(0 4px 10px #02102e66)}
.crm-title-copy{padding-left:24px;border-left:1px solid #ffffff35;white-space:nowrap}.crm-banner h1{color:#fff;font-size:20px;margin:0 0 9px}.crm-banner p{color:#d5e5ff;font-size:12px;margin:0}
.crm-banner-actions{display:flex;flex-direction:column;align-items:flex-end;gap:30px}.crm-banner-actions a{display:flex;align-items:center;gap:9px;border:1px solid #ffffff55;border-radius:10px;padding:10px 14px;color:#fff;font-size:12px;text-decoration:none;background:#ffffff12}.crm-banner-actions a:hover{background:#ffffff28}.crm-powered{font-size:9px;letter-spacing:.6px;color:#c3d8fb}.crm-powered b{color:#fff}
.crm-data-alert{margin:14px 28px 0;padding:12px 14px;border:1px solid #f1c96a;border-radius:12px;background:#fff8df;color:#5f4300;display:flex;align-items:center;justify-content:space-between;gap:18px;box-shadow:0 4px 14px rgba(89,61,0,.05)}.crm-data-alert div{display:grid;gap:3px}.crm-data-alert b{font-size:13px}.crm-data-alert span{font-size:11px;line-height:1.45;color:#765b18}.crm-data-alert button{border:1px solid #d9aa36;border-radius:9px;background:#fff;color:#6f5107;padding:8px 11px;font-size:11px;font-weight:900;white-space:nowrap;cursor:pointer}.crm-data-alert button:hover{background:#fff1b8}
.kpis{grid-template-columns:repeat(5,minmax(130px,180px));gap:10px;padding:16px 28px}.kpi{display:block;padding:12px 14px;background:linear-gradient(135deg,#fff,#edf4ff);border-color:#d4e2f7}.kpi>span{font-size:10px}.kpi-value{display:flex;align-items:center;justify-content:space-between;margin-top:8px;gap:14px}.kpi strong{margin:0;font-size:27px;line-height:1}.kpi-icon{border-radius:10px;width:30px;height:30px;background:#ddeaff;color:#2456a2}.kpi-icon svg{width:18px;height:18px;stroke-width:1.6}
.buddy-app .table-card .kpi{max-width:200px;width:100%}
@media(max-width:760px){.buddy-app .topbar.crm-banner{padding:18px 14px 16px 115px!important}.buddy-app .topbar.crm-banner h1{font-size:14px!important}.buddy-app .crm-buddy{background-size:auto 170px;background-position:30% 6px}}
@media(max-width:1100px){.kpis{grid-template-columns:repeat(5,minmax(0,1fr))}.crm-banner{padding-left:165px}.crm-buddy{left:10px;width:140px}.crm-brand-copy{gap:14px}.crm-brand-copy img{width:220px}.crm-title-copy{padding-left:14px}.crm-banner-actions{gap:15px}}
@media(max-width:760px){.crm-banner{padding:14px 12px 14px 105px;min-height:148px;display:block}.crm-buddy{left:0;width:98px;height:145px;background-size:auto 190px}.crm-brand-copy{display:block}.crm-brand-copy img{width:170px;max-width:100%;height:52px}.crm-title-copy{padding:0;border:0;white-space:normal}.crm-banner h1{font-size:13px;margin:2px 0 4px}.crm-banner-actions{align-items:flex-start;gap:6px;margin-top:7px}.crm-banner-actions a{font-size:9px;padding:5px 8px}.crm-powered{font-size:7px}.crm-data-alert{margin:10px 18px 0;align-items:flex-start;gap:10px}.crm-data-alert span{font-size:10px}.crm-data-alert button{padding:7px 9px}.kpis{grid-template-columns:repeat(2,minmax(0,1fr));padding:12px 18px}.kpi{min-width:0}}

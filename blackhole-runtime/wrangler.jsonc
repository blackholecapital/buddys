{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "buddys-assistant-adapter",
  "main": "src/index.js",
  "compatibility_date": "2026-08-31",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "buddys-assistant.xyz-labs.xyz",
      "custom_domain": true
    }
  ],
  "vars": {
    "TENANT_ID": "buddys",
    "APP_ORIGIN": "https://buddys-assistant.xyz-labs.xyz",
    "RUNTIME_URL": "https://blackhole-runtime.xyz-labs.xyz",
    "CF_ACCESS_TEAM_DOMAIN": "https://xyzx-labs.cloudflareaccess.com",
    "CF_ACCESS_AUD": "89757ca97858490ae62553589cd45044f82caec09dfac238698969f739bfc1a6"
  },
  "r2_buckets": [
    {
      "binding": "ASSISTANT_ASSETS",
      "bucket_name": "buddys-assistant-assets"
    }
  ],
  "services": [
    {
      "binding": "VIDEO",
      "service": "blackhole-video-worker"
    }
  ],
  "secrets_store_secrets": [
    {
      "binding": "BLACKHOLE_RUNTIME_TOKEN",
      "store_id": "00b34d29f2c94685b0f250dc5b1ee875",
      "secret_name": "XYZ_DEMO_EILA_RUNTIME_TOKEN"
    },
    {
      "binding": "BLACKHOLE_CAPABILITY_TOKEN",
      "store_id": "00b34d29f2c94685b0f250dc5b1ee875",
      "secret_name": "XYZ_DEMO_EILA_RUNTIME_TOKEN"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*",
      "/settings/api/*",
      "/assets/assistants/*"
    ]
  }
}
